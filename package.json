{
  "name": "ui-automation-samples",
  "version": "1.0.0",
  "description": "Illumina-inspired Run Setup demo app used as a UI automation interview target",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test:selenium": "mocha --config test/selenium/.mocharc.json",
    "test:playwright": "playwright test --config test/playwright/playwright.config.ts",
    "test": "npm run test:selenium && npm run test:playwright"
  },
  "dependencies": {
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-session": "^1.18.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/chai": "^4.3.20",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "@types/selenium-webdriver": "^4.1.27",
    "chai": "^4.5.0",
    "mocha": "^12.0.3",
    "selenium-webdriver": "^4.27.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
