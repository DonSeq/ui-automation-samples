<%- include('partials-head', { title: 'Review' }) %>
<main class="container">
  <ol class="steps" aria-label="Progress">
    <li class="done">Home</li><li class="done">Run Setup</li><li class="current" aria-current="step">Review</li>
  </ol>
  <section class="card" id="review-card" data-testid="review-card">
    <h1 id="review-title" data-testid="review-title">Review</h1>
    <table class="review-table" id="review-table" data-testid="review-table">
      <thead><tr><th scope="col">Setting</th><th scope="col">Value</th></tr></thead>
      <tbody>
        <tr id="review-row-runName" data-testid="review-row-runName"><th scope="row">Run Name</th><td id="review-runName" data-testid="review-runName"><%= setup.runName %></td></tr>
        <tr id="review-row-readType" data-testid="review-row-readType"><th scope="row">Read Type</th><td id="review-readType" data-testid="review-readType"><%= setup.readType %></td></tr>
        <tr id="review-row-readLength" data-testid="review-row-readLength"><th scope="row">Read Length (bp)</th><td id="review-readLength" data-testid="review-readLength"><%= setup.readLength %></td></tr>
        <tr id="review-row-analysis" data-testid="review-row-analysis"><th scope="row">Secondary Analysis</th><td id="review-analysis" data-testid="review-analysis"><%= setup.analysis %></td></tr>
      </tbody>
    </table>
    <div class="actions">
      <a href="/setup" class="btn btn-secondary" role="button" id="back-button" data-testid="back-button">Back</a>
      <button type="button" class="btn btn-primary" id="confirm-button" data-testid="confirm-button">Confirm</button>
    </div>
  </section>
</main>

<dialog id="run-started-dialog" class="modal" aria-labelledby="run-started-title" data-testid="run-started-dialog">
  <h2 id="run-started-title" data-testid="run-started-title">Run Started</h2>
  <p class="muted" id="run-started-message" data-testid="run-started-message">Your run has been started successfully.</p>
  <button type="button" class="btn btn-primary" id="run-started-close" data-testid="run-started-close">Close</button>
</dialog>
<script>
  var dialog = document.getElementById('run-started-dialog');
  // Closing the dialog by any route (button, Esc) returns to Home.
  dialog.addEventListener('close', function () { window.location.href = '/home'; });
  document.getElementById('run-started-close').addEventListener('click', function () { dialog.close(); });
  document.getElementById('confirm-button').addEventListener('click', function () {
    fetch('/review/confirm', { method: 'POST' }).then(function (r) {
      if (r.ok) dialog.showModal();
    });
  });
</script>
<%- include('partials-footer') %>
